                    <div class="flip">
                        <div class="front" style="background-image: url(img/imag-mail2.jpg);">

                        </div>
                        <div class="back">

                            <p><a href='aziz.elmadraj@gmail.com'>aziz.elmadraj@gmail.com</a></p>
                        </div>
                    </div>
                    <div class="flip">
                        <div class="front" style="background-image: url(img/git-hub.jpg)">

                        </div>
                        <div class="back">

                            <p><i class='fab fa-github fa-2x mr-2'></i> <a href='https://github.com/aziz0404'
