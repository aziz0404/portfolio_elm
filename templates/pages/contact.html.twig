                </div>
            </div>
            <div class='container'>
                <form id='contact' class='contact-form' action='index.php?page=contactform  ' method='post'>
                    <h3>Contactez moi</h3>

                    <fieldset>
                        <input placeholder='Votre nom' name='name' type='text' tabindex='1' required autofocus>
                    </fieldset>
                    <fieldset>
                        <input placeholder='Votre adresse mail' name='email' type='email' tabindex='2' required>
                    </fieldset>
                    <fieldset>
                        <input placeholder='Votre numéro de téléphone (optionel)' name='tel' type='tel' tabindex='3'>
                    </fieldset>
                    <fieldset>
                        <input placeholder='Votre site, web (optionel)' type='url' name='url' tabindex='4'>
                    </fieldset>
                    <fieldset>
                        <textarea placeholder='Donnez votre message ici....' tabindex='5' name='message'
                            required></textarea>
                    </fieldset>
                    <fieldset>
                        <button name='submit' type='submit' id='contact-submit'
                            data-submit='...Sending'>Soumettre</button>
                    </fieldset>

                </form>
            </div>


        </div>
    </div>
</main>



